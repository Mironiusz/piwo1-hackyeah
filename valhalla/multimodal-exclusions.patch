+// PATCH(multimodal-exclusions): composite costings (multimodal, transit, bikeshare,
+// auto_pedestrian) are expanded by sif::CostFactory::CreateModeCosting into one costing per
+// travel mode, each built from options.costings()[<component type>]. Exclusions stored only on
+// the composite costing are lost there, e.g. on the walking legs of a multimodal route. Return
+// every costing options entry that will actually be instantiated, so exclusions go to all of them.
+std::vector<valhalla::Costing_Options*> exclusion_targets(valhalla::Options& options) {
+  std::vector<valhalla::Costing_Options*> targets;
+  auto* costings = options.mutable_costings();
+  auto add = [&](valhalla::Costing::Type type) {
+    auto it = costings->find(type);
+    if (it != costings->end())
+      targets.push_back(it->second.mutable_options());
+  };
+  auto mapping = valhalla::sif::kCostingTypeMapping.find(options.costing_type());
+  if (mapping == valhalla::sif::kCostingTypeMapping.end()) {
+    add(options.costing_type());
+  } else {
+    for (const auto type : mapping->second)
+      add(type);
+  }
+  return targets;
 }
+} // namespace
 
