diff --git a/src/mjolnir/transitbuilder.cc b/src/mjolnir/transitbuilder.cc
index cd9209c..170895f 100644
--- a/src/mjolnir/transitbuilder.cc
+++ b/src/mjolnir/transitbuilder.cc
@@ -286,7 +286,11 @@ void ConnectToGraph(GraphTileBuilder& tilebuilder_local,
     nb.set_edge_index(edge_index);
 
     // reset the access to defaults.
-    nb.set_access((kPedestrianAccess | kWheelchairAccess | kBicycleAccess));
+    // PATCH(stop-accessibility): keep the stop's wheelchair bit (GTFS wheelchair_boarding, set by
+    // convert_transit) on the transit node instead of resetting it, so thor can refuse boarding,
+    // alighting and transfers there when transit.wheelchair=true. Without this the information
+    // only survives on the egress<->OSM connection edges.
+    nb.set_access(kPedestrianAccess | kBicycleAccess | (nb.access() & kWheelchairAccess));
     nb.set_edge_count(tilebuilder_transit.directededges().size() - edge_index);
     tilebuilder_transit.nodes().emplace_back(std::move(nb));
   }
