# The environment of the frontend process: `npm run dev` and `npm run preview`.
# Copy this file to `.env.local` in this directory, which git ignores, and fill it in,
# or set the same entries in the environment of the process, which takes precedence.
# The built application reads none of them: it calls the host it was loaded from.
# No entry is a secret. An entry left empty counts as not set.

# The address of the running backend, with the scheme, the host and the port, without a path.
# Every request under /api goes there. It is the address the backend listens on, API_BIND_HOST
# and API_PORT of the environment file of the repository, for example http://127.0.0.1:8000.
# Not set: every request goes to the mock server of this directory, http://127.0.0.1:8787.
VITE_API_PROXY_TARGET=

# The address and the port the preview listens on when it serves the built application on a server,
# for example 0.0.0.0 and 8080. Not set: localhost and 4173, which only the machine itself reaches.
# The backend has to name the address this process connects from in its API_TRUSTED_PROXY_ADDRESSES,
# or every person without an account shares one identity for votes.
FRONTEND_HOST=
FRONTEND_PORT=

# Leave both empty when the backend answers every operation the frontend uses.
# The paths under /api, separated by commas, that go to the mock server instead of the backend,
# for example /api/osm-copy, and the address of that mock server when it is not http://127.0.0.1:8787.
# The mock server is then started with `npm run mock:beside`.
VITE_API_MOCK_PATHS=
VITE_API_MOCK_TARGET=
